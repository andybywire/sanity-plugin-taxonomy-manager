{
  "extends": "./tsconfig.settings.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "."
  },
  "include": ["src", "global.d.ts"],
  "exclude": [
    "src/**/__fixtures__",
    "src/**/__mocks__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/test",
    "src/test-setup.ts"
  ]
}
