# Expose @sanity/* packages provided transitively by the `sanity` peer at the
# project root (the way npm's flat node_modules did) so phantom imports resolve
# in local dev. @sanity/uuid is now a declared dependency (see package.json);
# the remaining phantom import is @sanity/util/paths in ConceptUseView, which is
# version-locked to `sanity` and deferred until that view is refactored. Using
# sanity's own copies avoids cross-major version skew.
# Keep eslint/prettier public so editor/CLI tooling resolves them.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@sanity/uuid
public-hoist-pattern[]=@sanity/util
public-hoist-pattern[]=@sanity/*
