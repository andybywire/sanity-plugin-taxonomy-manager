# Expose @sanity/* packages provided transitively by the `sanity` peer (e.g.
# @sanity/uuid, @sanity/util/paths) at the project root, the way npm's flat
# node_modules did. These are phantom deps in the current source; the proper
# fix (import from `sanity` or declare explicitly) is deferred to the Stage 3/4
# refactor. Using sanity's own copies avoids cross-major version skew.
# Keep eslint/prettier public so editor/CLI tooling resolves them.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@sanity/uuid
public-hoist-pattern[]=@sanity/util
public-hoist-pattern[]=@sanity/*
